{
    "name": "modularize-rbac/core",
    "version": "1.10.0",
    "description": "Framework-agnostic core for modular RBAC: modules, roles, permissions, i18n translations. Pure PHP, hexagonal architecture.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "rbac",
        "permissions",
        "roles",
        "modules",
        "access-control",
        "i18n",
        "hexagonal",
        "ddd"
    ],
    "authors": [
        {
            "name": "Christopher",
            "email": "christophertheilacher@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/chrisdjst/access-core/issues",
        "source": "https://github.com/chrisdjst/access-core",
        "docs": "https://github.com/chrisdjst/access-core#readme",
        "chat": "https://github.com/chrisdjst/access-core/discussions"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/chrisdjst"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "ModularizeRbac\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModularizeRbac\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
